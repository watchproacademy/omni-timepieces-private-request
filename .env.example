# Development/preview only: demo inquiries do not send emails or write to a database.
WATCH_REQUEST_PREVIEW_MODE=true
# Production: set preview mode false. Keep all credentials server-only.
DATABASE_URL=postgresql://user:password@your-neon-host/database?sslmode=require
RESEND_API_KEY=re_your_api_key
WATCH_REQUEST_FROM_EMAIL="Omni Private Desk <requests@your-verified-domain.com>"
WATCH_REQUEST_TO_EMAIL=owner@example.com
WATCH_REQUEST_REPLY_TO_EMAIL=owner@example.com
WATCH_REQUEST_ALERT_EMAIL=owner@example.com
# Generate independent random secrets of at least 32 characters.
ABUSE_HASH_SECRET=replace-with-a-random-secret-at-least-32-characters
CRON_SECRET=replace-with-another-random-secret-at-least-32-characters
# Optional owner-delivery alternative; receipt emails still require Resend.
# WATCH_REQUEST_WEBHOOK_URL=https://your-webhook.example/inquiries
# WATCH_REQUEST_WEBHOOK_BEARER=optional-token
